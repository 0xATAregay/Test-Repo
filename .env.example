# EdgeLab optional environment
# The application works in local/demo mode with every value blank.

# Optional future PostgreSQL cloud adapter
DATABASE_URL=

# Optional provider-agnostic AI server adapter. Never expose this with NEXT_PUBLIC_.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional object storage for validated user attachments
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
